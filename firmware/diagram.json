{
  "version": 1,
  "author": "flood-ews Smart Community Flood Monitoring",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "sonar",
      "top": -140,
      "left": -120,
      "attrs": { "distance": "80" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "rain_pot",
      "top": 160,
      "left": -140,
      "attrs": { "min": "0", "max": "100", "value": "15" }
    },
    {
      "type": "wokwi-servo",
      "id": "gate_servo",
      "top": -120,
      "left": 160,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 80,
      "left": 180,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 140,
      "left": 180,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": 110,
      "left": 140,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": 170,
      "left": 140,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 220,
      "left": 160,
      "attrs": { "volume": "0.5" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "sonar:VCC", "esp:VIN", "red", [ "v0" ] ],
    [ "sonar:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "sonar:TRIG", "esp:D5", "blue", [ "v0" ] ],
    [ "sonar:ECHO", "esp:D18", "yellow", [ "v0" ] ],

    [ "rain_pot:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "rain_pot:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "rain_pot:SIG", "esp:D34", "purple", [ "v0" ] ],

    [ "gate_servo:V+", "esp:VIN", "red", [ "v0" ] ],
    [ "gate_servo:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "gate_servo:PWM", "esp:D19", "orange", [ "v0" ] ],

    [ "esp:D22", "r_green:1", "green", [ "v0" ] ],
    [ "r_green:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:D21", "r_red:1", "red", [ "v0" ] ],
    [ "r_red:2", "led_red:A", "red", [ "v0" ] ],
    [ "led_red:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:D23", "buzzer:1", "purple", [ "v0" ] ],
    [ "buzzer:2", "esp:GND.2", "black", [ "v0" ] ]
  ]
}
