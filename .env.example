# ============================================================================
# flood-ews Environment Configuration Template
# ============================================================================

# Application Environment (development / production)
APP_ENV=production
DEBUG=false
PUBLIC_URL=http://localhost:3000

# TimescaleDB / PostgreSQL Configuration
POSTGRES_DB=flood_ews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongProductionPassword123!
DATABASE_URL=postgresql://postgres:ChangeThisToAStrongProductionPassword123!@localhost:5432/flood_ews

# MQTT Message Broker (HiveMQ Cloud / AWS IoT / Local Mosquitto)
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=flood_operator
MQTT_PASSWORD=ChangeThisMqttSecret456!
MQTT_USE_TLS=false

# Security & Operator RBAC
OPERATOR_API_KEY=prod-operator-super-secret-token-789

# Emergency Alert Dispatcher (Live Twilio SMS & WhatsApp)
MOCK_ALERTS=true
ALERT_COOLDOWN_SECONDS=900
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Predictive Meteorological Forecast Engine (Open-Meteo & IMD)
PREDICTIVE_WEATHER_ENABLED=true
WEATHER_API_LAT=17.3753
WEATHER_API_LON=78.4900
WEATHER_CACHE_MINUTES=30
PREDICTIVE_RAIN_WATCH_THRESHOLD=40.0

# Frontend Next.js API & WebSocket URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
