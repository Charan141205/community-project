# Database (TimescaleDB / PostgreSQL)
POSTGRES_DB=flood_ews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flood_ews

# MQTT Broker (Default to local Mosquitto or broker.hivemq.com for Wokwi)
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883

# Security & Operator Auth
OPERATOR_API_KEY=dev-operator-key-42

# Multilingual Alerts
MOCK_ALERTS=true
ALERT_COOLDOWN_SECONDS=900
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend & Public URL
PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
